
# ================ EXECUTION MODE ================
# "local" = run without Docker (free, recommended for Windows)
# "docker" = run with Docker containers (original behavior)
EXECUTION_MODE=local

# ================ LLM CONFIGURATION (FREE with Ollama) ================
# Default: Ollama local models (completely free, runs on your machine)
# Install Ollama: https://ollama.com
# Then run: ollama pull llama3.1:8b
#
# For paid models, change to:
#   COMPLETION_MODEL=gpt-4o-2024-08-06  (needs OPENAI_API_KEY)
#   COMPLETION_MODEL=openrouter/google/gemini-2.5-pro-preview-05-20  (needs OPENROUTER_API_KEY)
COMPLETION_MODEL=ollama/llama3.1:8b
CHEEP_MODEL=ollama/llama3.1:8b

# ================ EMBEDDING CONFIGURATION (FREE) ================
# "Local" = free sentence-transformers (no API key needed)
# "OpenAI" = paid OpenAI embeddings (needs OPENAI_API_KEY)
EMBEDDING_PLATFORM=Local
EMBEDDING_MODEL=local

# ================ SSL CONFIGURATION ================
# Set to "true" to bypass SSL certificate verification
# Needed for corporate networks with proxy/firewall that intercepts HTTPS
DISABLE_SSL_VERIFY=true

# ================ CONTAINER CONFIGURATION (only for docker mode) ================
# workplace of the research agent
DOCKER_WORKPLACE_NAME=workplace_paper
# base image of the research agent
BASE_IMAGES=tjbtech1/airesearcher:v1
# specific gpu: '"device=0"', '"device=0,1"', '"all"', or None for no gpu
GPUS=None
# name of the container
CONTAINER_NAME=paper_eval
# name of the workplace
WORKPLACE_NAME=workplace
# path of the cache
CACHE_PATH=cache
# port of the research agent
PORT=7020
# platform of the research agent
PLATFORM=linux/amd64

# ================ API KEYS (only needed for paid models) ================
# OpenAI API key (only if using gpt-4o or OpenAI embeddings)
# OPENAI_API_KEY=your_openai_api_key

# OpenRouter API key (only if using openrouter/ models)
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# GitHub AI token (for code search functionality)
# GITHUB_AI_TOKEN=your_github_ai_token

# ================ TASK CONFIGURATION ================
# category: diffu_flow, gnn, reasoning, recommendation, vq
CATEGORY=vq
# instance id, example: one_layer_vq
INSTANCE_ID=one_layer_vq
# task level: task1, task2
TASK_LEVEL=task1
# maximum iteration times
MAX_ITER_TIMES=0
